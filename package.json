{
  "name": "@squai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "biome check . && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply certificates --local",
    "keys:generate": "node scripts/generate-keys.mjs",
    "templates:pdf": "node scripts/export-pdf-templates.mjs",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261018.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20260930.0-alpha",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
